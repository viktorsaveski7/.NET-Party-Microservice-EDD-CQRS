{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "party-route": {
        "ClusterId": "party-cluster",
        "Match": {
          "Path": "/api/parties/{**catch-all}"
        }
      },
      "guest-route": {
        "ClusterId": "guest-cluster",
        "Match": {
          "Path": "/api/guests/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "party-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "guest-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}